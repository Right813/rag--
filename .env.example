APP_ENV=development
APP_NAME=知库智答

# 本机运行 API 时使用 127.0.0.1；API 运行在 Docker 时改为 host.docker.internal
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=rag_kg
# API 运行在 Docker 时，使用宿主机网关访问本机数据库
DOCKER_MYSQL_HOST=host.docker.internal

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DOCKER_REDIS_HOST=host.docker.internal

# Neo4j 由 docker compose 提供
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=knowledge
NEO4J_ENABLED=true

# 可选：留空时使用本地可运行的 grounded fallback
# Ollama 示例：http://127.0.0.1:11434/v1，API Key 可填写 ollama
# 云端 OpenAI-compatible 服务请填写对应 base URL、Key 和模型名
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=30

CACHE_TTL_SECONDS=300
ADMIN_TOKEN=change-me
